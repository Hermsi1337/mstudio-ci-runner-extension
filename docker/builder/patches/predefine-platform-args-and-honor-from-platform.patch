diff --git a/cmd/executor/cmd/root.go b/cmd/executor/cmd/root.go
index 0a76fbb..a8f472e 100644
--- a/cmd/executor/cmd/root.go
+++ b/cmd/executor/cmd/root.go
@@ -104,6 +104,41 @@ func validateFlags() {
 	if _, err := v1.ParsePlatform(opts.CustomPlatform); err != nil {
 		logrus.Fatalf("Invalid platform %q: %v", opts.CustomPlatform, err)
 	}
+	addPlatformBuildArgs()
+}
+
+// addPlatformBuildArgs defines the platform arguments BuildKit predefines, so
+// Dockerfiles written for buildx resolve FROM --platform=$BUILDPLATFORM and
+// GOARCH=$TARGETARCH. A --build-arg of the same name wins.
+func addPlatformBuildArgs() {
+	build := platforms.Normalize(platforms.DefaultSpec())
+	target, err := v1.ParsePlatform(opts.CustomPlatform)
+	if err != nil {
+		logrus.Fatalf("Invalid platform %q: %v", opts.CustomPlatform, err)
+	}
+	predefined := []string{
+		"BUILDPLATFORM=" + platforms.Format(build),
+		"BUILDOS=" + build.OS,
+		"BUILDARCH=" + build.Architecture,
+		"BUILDVARIANT=" + build.Variant,
+		"TARGETPLATFORM=" + target.String(),
+		"TARGETOS=" + target.OS,
+		"TARGETARCH=" + target.Architecture,
+		"TARGETVARIANT=" + target.Variant,
+	}
+	for _, arg := range predefined {
+		key := strings.SplitN(arg, "=", 2)[0]
+		given := false
+		for _, existing := range opts.BuildArgs {
+			if existing == key || strings.HasPrefix(existing, key+"=") {
+				given = true
+				break
+			}
+		}
+		if !given {
+			opts.BuildArgs = append(opts.BuildArgs, arg)
+		}
+	}
 }
 
