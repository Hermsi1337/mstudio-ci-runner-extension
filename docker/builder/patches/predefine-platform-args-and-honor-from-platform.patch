+
+// StagePlatform returns the platform of a stage: the value of FROM --platform
+// with build args expanded, or the platform of the build.
+func StagePlatform(stage config.KanikoStage, opts *config.KanikoOptions) (string, error) {
+	if stage.Platform == "" {
+		return opts.CustomPlatform, nil
+	}
+	var buildArgs []string
+	for _, marg := range stage.MetaArgs {
+		for _, arg := range marg.Args {
+			buildArgs = append(buildArgs, fmt.Sprintf("%s=%s", arg.Key, arg.ValueString()))
+		}
+	}
+	buildArgs = append(buildArgs, opts.BuildArgs...)
+	platform, err := util.ResolveEnvironmentReplacement(stage.Platform, buildArgs, false)
+	if err != nil {
+		return "", err
+	}
+	if _, err := v1.ParsePlatform(platform); err != nil {
+		return "", fmt.Errorf("FROM --platform=%s resolves to %q: %w", stage.Platform, platform, err)
+	}
+	logrus.Infof("Stage %d uses platform %s", stage.Index, platform)
+	return platform, nil
 }
 
