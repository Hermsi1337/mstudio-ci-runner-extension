#!/usr/bin/env bash
# Checks a --platform value and prints each platform in its normal form, one per
# line: linux/amd64 or linux/arm64.
#
# The builder builds for both architectures. It runs RUN steps of the other one
# under qemu when its startup probe found emulation, and builds COPY-only or
# cross-compiling stages for it in any case. Other architectures have no
# emulator in the builder, so they fail here instead of deep inside kaniko.
#
# Usage:
#   mstudio-platform-check PLATFORM[,PLATFORM ...]
set -euo pipefail

requested="${1:-}"
[[ -z "${requested}" ]] && exit 0

IFS=',' read -r -a entries <<<"${requested}"
seen=" "
for entry in "${entries[@]}"; do
    entry="${entry// /}"
    [[ -z "${entry}" ]] && continue
    normalized="${entry#linux/}"
    case "${normalized}" in
        amd64 | x86_64 | amd64/v1) normalized=amd64 ;;
        arm64 | aarch64 | arm64/v8) normalized=arm64 ;;
        *)
            echo "mstudio-build: platform ${entry} is not supported, the builder builds linux/amd64 and linux/arm64" >&2
            exit 1
            ;;
    esac
    if [[ "${seen}" != *" ${normalized} "* ]]; then
        seen+="${normalized} "
        echo "linux/${normalized}"
    fi
done
