#!/usr/bin/env python3
"""Local image store for images built by the builder service of this stack.

There is no Docker daemon in the runner, so images built by `mstudio-build`
live as docker-archive tarballs on the data volume. This store keeps the
tarballs and the mapping from image references to them, which is what the
`docker` replacement needs for `docker tag`, `docker push` and `docker images`.

Usage:
  mstudio-image-store put TARBALL [REF ...]   copy the tarball in, print image id
  mstudio-image-store tarball REF|ID          print the path of the tarball
  mstudio-image-store resolve REF|ID          print the image id
  mstudio-image-store tag SOURCE TARGET       add another reference
  mstudio-image-store untag REF               remove a reference
  mstudio-image-store list                    print "REF  IMAGE ID  SIZE"
  mstudio-image-store config REF|ID           print the image config JSON

Environment:
  MSTUDIO_IMAGE_STORE  store directory (default: $RUNNER_DATA_DIR/images)
"""

from __future__ import annotations

import json
import os
import shutil
import sys
import tarfile
from pathlib import Path


def store_dir() -> Path:
    configured = os.environ.get("MSTUDIO_IMAGE_STORE")
    if configured:
        return Path(configured)
    data_dir = os.environ.get("RUNNER_DATA_DIR") or str(Path.home())

    return Path(data_dir) / "images"


def index_path() -> Path:
    return store_dir() / "index.json"


def read_index() -> dict[str, str]:
    try:
        return json.loads(index_path().read_text())
    except FileNotFoundError:
        return {}


def write_index(index: dict[str, str]) -> None:
    index_path().parent.mkdir(parents=True, exist_ok=True)
    temporary = index_path().with_suffix(".json.tmp")
    temporary.write_text(json.dumps(index, indent=2, sort_keys=True))
    temporary.replace(index_path())


def normalize(reference: str) -> str:
    if reference.startswith("sha256:"):
        return reference
    if "@" in reference or ":" in reference.rsplit("/", 1)[-1]:
        return reference

    return f"{reference}:latest"


def image_id_of_tarball(tarball: Path) -> str:
    with tarfile.open(tarball) as archive:
        manifest_member = archive.extractfile("manifest.json")
        if manifest_member is None:
            raise SystemExit(f"{tarball} has no manifest.json")
        manifest = json.loads(manifest_member.read())
    config = manifest[0]["Config"]
    digest = Path(config).stem

    return digest if digest.startswith("sha256:") else f"sha256:{digest}"


def blob_path(image_id: str) -> Path:
    return store_dir() / "blobs" / f"{image_id.removeprefix('sha256:')}.tar"


def resolve(reference: str) -> str:
    if reference.startswith("sha256:"):
        return reference
    index = read_index()
    image_id = index.get(normalize(reference))
    if image_id is None:
        raise SystemExit(f"no such image: {reference}")

    return image_id


def command_put(arguments: list[str]) -> None:
    tarball = Path(arguments[0])
    image_id = image_id_of_tarball(tarball)
    target = blob_path(image_id)
    target.parent.mkdir(parents=True, exist_ok=True)
    if not target.exists():
        shutil.copyfile(tarball, target)
    index = read_index()
    for reference in arguments[1:]:
        index[normalize(reference)] = image_id
    write_index(index)
    print(image_id)


def command_tarball(arguments: list[str]) -> None:
    image_id = resolve(arguments[0])
    tarball = blob_path(image_id)
    if not tarball.exists():
        raise SystemExit(f"no such image: {arguments[0]}")
    print(tarball)


def command_tag(arguments: list[str]) -> None:
    image_id = resolve(arguments[0])
    index = read_index()
    index[normalize(arguments[1])] = image_id
    write_index(index)


def command_untag(arguments: list[str]) -> None:
    index = read_index()
    reference = normalize(arguments[0])
    if index.pop(reference, None) is None:
        raise SystemExit(f"no such image: {arguments[0]}")
    write_index(index)


def command_list(_: list[str]) -> None:
    index = read_index()
    print(f"{'REPOSITORY:TAG':<50} {'IMAGE ID':<20} SIZE")
    for reference, image_id in sorted(index.items()):
        tarball = blob_path(image_id)
        size = tarball.stat().st_size if tarball.exists() else 0
        short = image_id.removeprefix("sha256:")[:12]
        print(f"{reference:<50} {short:<20} {size // (1024 * 1024)}MB")


def command_config(arguments: list[str]) -> None:
    image_id = resolve(arguments[0])
    with tarfile.open(blob_path(image_id)) as archive:
        manifest_member = archive.extractfile("manifest.json")
        if manifest_member is None:
            raise SystemExit(f"no manifest.json in the tarball of {arguments[0]}")
        manifest = json.loads(manifest_member.read())
        config_member = archive.extractfile(manifest[0]["Config"])
        if config_member is None:
            raise SystemExit(f"no config in the tarball of {arguments[0]}")
        print(config_member.read().decode())


COMMANDS = {
    "put": command_put,
    "tarball": command_tarball,
    "resolve": lambda arguments: print(resolve(arguments[0])),
    "tag": command_tag,
    "untag": command_untag,
    "list": command_list,
    "config": command_config,
}


def main() -> None:
    if len(sys.argv) < 2 or sys.argv[1] in {"-h", "--help"}:
        print(__doc__)
        raise SystemExit(0 if len(sys.argv) > 1 else 2)
    command = COMMANDS.get(sys.argv[1])
    if command is None:
        raise SystemExit(f"unknown command: {sys.argv[1]}")
    command(sys.argv[2:])


if __name__ == "__main__":
    main()
