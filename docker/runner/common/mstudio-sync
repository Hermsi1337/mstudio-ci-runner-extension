#!/usr/bin/env bash
# Copies files into a project directory the extension mounted into the runner
# (docs/runner-image.md). The runner user does not own the project files, so a
# plain write fails, and a write with sudo leaves files owned by root that SFTP
# and the app cannot change any more.
#
# Root only looks: it resolves DEST and reads the owner of its nearest existing
# directory. Every write into the project directory runs as that owner, so a
# symlink someone swaps in between reaches only what the owner may write
# anyway. SRC is staged in a private directory the owner can read.
#
# Usage: mstudio-sync [--delete] SRC DEST
#
# Environment:
#   MSTUDIO_PROJECT_DIRECTORIES  colon separated paths of the project
#                                directories in the runner, set by the extension
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: mstudio-sync [--delete] SRC DEST

Copies SRC into the directory DEST as the owner of DEST, or of its nearest
existing parent, so the files belong to the project user. Every directory it
copies gets mode 755 and every file 644, files that already exist in DEST
included. DEST must lie in a project directory of this runner.

As with rsync, SRC/ copies the contents of SRC (and gives DEST mode 755), SRC
without a trailing slash copies the directory itself. Missing directories up to
DEST are created. Put -- before a SRC that starts with a dash.

Options:
  --delete    remove files in DEST that SRC lacks
  -h, --help  show this help
EOF
}

fail() {
    echo "mstudio-sync: $*" >&2
    exit 1
}

delete=()
while (($# > 0)); do
    case "$1" in
        --delete)
            delete=(--delete)
            shift
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*) fail "unknown option $1, see mstudio-sync --help" ;;
        *) break ;;
    esac
done
if (($# != 2)); then
    usage >&2
    exit 2
fi
src="$1"
dest="$2"

[[ -e "${src}" ]] || fail "${src} does not exist"
[[ -n "${MSTUDIO_PROJECT_DIRECTORIES:-}" ]] ||
    fail "this runner has no project directories, add one in the runner settings"

# The project user may keep the runner out of its directories, so the lookups
# run as root. realpath resolves .. and symlinks, so neither leads out of the
# mount.
dest_path="$(sudo realpath -m -- "${dest}")"
mount=""
IFS=: read -r -a targets <<<"${MSTUDIO_PROJECT_DIRECTORIES}"
for target in "${targets[@]}"; do
    [[ -n "${target}" ]] || continue
    target_path="$(sudo realpath -m -- "${target}")"
    if [[ "${dest_path}" == "${target_path}" || "${dest_path}" == "${target_path}/"* ]]; then
        mount="${target_path}"
        break
    fi
done
[[ -n "${mount}" ]] ||
    fail "${dest} is not in a project directory of this runner: ${MSTUDIO_PROJECT_DIRECTORIES//:/, }"

mounted="$(findmnt -n -o TARGET -T "${mount}" 2>/dev/null || true)"
[[ "${mounted}" == "${mount}" ]] ||
    fail "${mount} is not mounted, save the runner settings again to recreate the container"
options="$(findmnt -n -o OPTIONS -T "${mount}" 2>/dev/null || true)"
[[ -n "${options}" ]] || fail "cannot read the mount options of ${mount}"
[[ ",${options}," != *,ro,* ]] ||
    fail "${mount} is mounted read only, turn off Read only for it in the runner settings"

existing="${dest_path}"
missing=()
while ! sudo test -e "${existing}"; do
    missing=("${existing}" "${missing[@]}")
    existing="$(dirname -- "${existing}")"
done
sudo test -d "${existing}" || fail "${existing} is not a directory"
owner="$(sudo stat -c %u:%g -- "${existing}")"
uid="${owner%:*}"
gid="${owner#*:}"
[[ "${uid}" != 0 ]] ||
    fail "${existing} belongs to root, mstudio-sync writes only as the owner of project files"

as_owner() {
    sudo setpriv --reuid="${uid}" --regid="${gid}" --clear-groups -- "$@"
}

stage="$(sudo mktemp -d)"
trap 'sudo rm -rf -- "${stage}"' EXIT
# rsync reads host:path as a remote source; ./ keeps a relative SRC local.
[[ "${src}" == /* ]] || src="./${src}"
if [[ -d "${src}" && ("${src}" == */ || "${src}" == */.) ]]; then
    item="${stage}/"
else
    item="${stage}/$(basename -- "${src}")"
fi
sudo rsync -rlt -- "${src}" "${stage}/"
sudo chown -R "${owner}" -- "${stage}"

if ((${#missing[@]} > 0)); then
    as_owner install -d -m 755 -- "${missing[@]}"
fi
as_owner rsync -rltp "${delete[@]}" --chmod=D755,F644 -- "${item}" "${dest_path}/"
