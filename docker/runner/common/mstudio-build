#!/usr/bin/env bash
# Builds a container image from a CI job and optionally pushes it.
#
# The runner container has no Docker daemon and no privileges to build images
# itself. It hands the build to the builder service of the same stack through a
# shared directory in the project file system, streams its log and imports the
# resulting tarball into the local image store (see mstudio-image-store).
#
# Usage:
#   mstudio-build [options] [CONTEXT]
#
#   -t, --tag NAME[:TAG]     image reference, repeatable
#   -f, --dockerfile PATH    Dockerfile relative to the working directory, - reads
#                            it from stdin (default: CONTEXT/Dockerfile)
#       --build-arg K=V      build argument, repeatable
#       --build-context NAME=VALUE
#                            extra context for FROM NAME and COPY --from=NAME,
#                            repeatable. VALUE is a local directory or
#                            docker-image://REF
#       --label K=V          image label, repeatable
#       --target STAGE       build stage to stop at
#       --push               push every tag with crane after a successful build
#       --iidfile PATH       write the image id (config digest) to PATH
#       --metadata-file PATH write buildx style metadata JSON to PATH
#       --platform LIST      linux/amd64, linux/arm64 or both, comma separated.
#                            Several platforms build one image each and push
#                            them as one index, so they need --push
#       --timeout SECONDS    how long to wait for the builder (default: 3600)
#       --quiet              only print the image reference
#
# Environment:
#   BUILD_QUEUE_DIR  directory shared with the builder (default: /builds)
set -euo pipefail

queue_dir="${BUILD_QUEUE_DIR:-/builds}"
context="."
dockerfile=""
dockerfile_source=""
dockerfile_from_stdin=false
target=""
# The builder stops a build after BUILD_TIMEOUT (3600s by default) and writes a
# result, so the runner waits a little longer than that and never gives up on a
# build that is still running.
timeout_seconds="${MSTUDIO_BUILD_TIMEOUT:-3900}"
push=false
quiet=false
iidfile=""
metadata_file=""
tags=()
build_args=()
labels=()
platforms=()
jobs=()
contexts_dir=".mstudio-contexts"
heredoc_start='<<(-?)["'\'']?([A-Za-z_][A-Za-z0-9_]*)'
context_names=()
declare -A context_dirs=()
declare -A context_images=()
staging=""
request_dockerfile=""

log() {
    if [[ "${quiet}" == false ]]; then
        echo "$@" >&2
    fi
}

fail() {
    echo "mstudio-build: $*" >&2
    exit 1
}

usage() {
    sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'
}

# Prints the path of a file relative to the context, or returns 1 when the file
# lies outside of it. Inside or outside follows the resolved symlinks, because
# the copy of the context keeps them and a link to the outside breaks in the
# builder. The printed path stays the one -f names where it can, so kaniko
# looks for the same <Dockerfile>.dockerignore as Docker does.
path_in_context() {
    local root file lexical_root lexical_file
    root="$(realpath -e -- "${context}")"
    root="${root%/}"
    file="$(realpath -e -- "$1")"
    [[ "${file}" == "${root}/"* ]] || return 1
    lexical_root="$(realpath -s -- "${context}")"
    lexical_root="${lexical_root%/}"
    lexical_file="$(realpath -s -- "$1")"
    if [[ "${lexical_file}" == "${lexical_root}/"* ]]; then
        echo "${lexical_file#"${lexical_root}/"}"
    else
        echo "${file#"${root}/"}"
    fi
}

# BuildKit takes a named context from a directory, an image, another target, an
# OCI layout, a URL or a git repository. kaniko has no named contexts, so the
# first two become stages in front of the Dockerfile and the rest is refused.
parse_build_context() {
    local entry="$1" name="${1%%=*}" value="${1#*=}"
    [[ "${entry}" == *=* && -n "${name}" && -n "${value}" ]] || fail "--build-context ${entry} needs the form NAME=VALUE"
    if [[ ! "${name}" =~ ^[a-z][a-z0-9_.-]*$ ]]; then
        fail "--build-context ${name}: the name has to be a stage name (lowercase letters, digits, '-', '_' and '.', starting with a letter). An image reference like alpine:3.20 cannot be one, use alpine instead"
    fi
    if [[ -v context_dirs["${name}"] || -v context_images["${name}"] ]]; then
        fail "--build-context ${name} is given twice"
    fi
    case "${value}" in
        docker-image://*)
            local reference="${value#docker-image://}"
            [[ -n "${reference}" && "${reference}" != *[[:space:]]* ]] || fail "--build-context ${entry} names no image"
            context_images["${name}"]="${reference}"
            ;;
        *://* | target:* | git@*)
            fail "--build-context ${entry} is not supported. The builder takes a local directory or docker-image://REF"
            ;;
        *)
            [[ -d "${value}" ]] || fail "--build-context ${entry}: ${value} is not a directory. The builder takes a local directory or docker-image://REF"
            context_dirs["${name}"]="${value}"
            ;;
    esac
    context_names+=("${name}")
}

print_context_stages() {
    local name
    for name in "${context_names[@]}"; do
        if [[ -v context_images["${name}"] ]]; then
            printf 'FROM %s AS %s\n' "${context_images[${name}]}" "${name}"
        else
            printf 'FROM scratch AS %s\nCOPY %s/%s/ /\n' "${name}" "${contexts_dir}" "${name}"
        fi
    done
}

# Splits the COPY or ADD in joined into copy_keyword, copy_flags, copy_sources,
# copy_destination and copy_json, which the caller declares. Shell and JSON
# form alike. Returns 1 when there is no source and destination to split.
split_copy() {
    local joined="$1" index list
    local -a words=()
    read -r -a words <<<"${joined}"
    copy_keyword="${words[0]}"
    copy_flags=()
    copy_json=false
    index=1
    while [[ ${index} -lt ${#words[@]} && "${words[index]}" == --* ]]; do
        copy_flags+=("${words[index]}")
        index=$((index + 1))
    done
    if [[ "${words[index]:-}" == '['* && "${joined}" =~ (\[.*\])[[:space:]]*$ ]]; then
        copy_json=true
        list="$(jq -r 'if type == "array" then .[] else error("not an array") end' <<<"${BASH_REMATCH[1]}")" \
            || fail "${dockerfile}: cannot read the JSON form of ${joined}"
        mapfile -t copy_sources <<<"${list}"
    else
        copy_sources=("${words[@]:index}")
    fi
    [[ ${#copy_sources[@]} -ge 2 ]] || return 1
    copy_destination="${copy_sources[-1]}"
    unset 'copy_sources[-1]'
}

# BuildKit keeps every source inside its named context. Under
# .mstudio-contexts/NAME/ a ".." could reach the main context instead.
leaves_context() {
    local depth=0 part
    local -a parts=()
    IFS=/ read -r -a parts <<<"$1"
    for part in "${parts[@]}"; do
        case "${part}" in
            '' | .) ;;
            ..)
                depth=$((depth - 1))
                ((depth >= 0)) || return 0
                ;;
            *) depth=$((depth + 1)) ;;
        esac
    done

    return 1
}

# kaniko saves the whole root file system of a stage when a later COPY --from
# takes / or . from it, and fails on /proc. A local context is part of the
# build context anyway, so COPY --from=NAME reads from its directory there.
copy_from_context() {
    local name="$1" flag source
    local -a rewritten=() kept=("${copy_keyword}")
    for flag in "${copy_flags[@]}"; do
        [[ "${flag}" == --from=* ]] || kept+=("${flag}")
    done
    for source in "${copy_sources[@]}"; do
        if leaves_context "${source}"; then
            fail "${dockerfile}:${pending_line}: COPY --from=${name} ${source} reaches outside the build context ${name}, name a path inside it"
        fi
        while [[ "${source}" == /* ]]; do
            source="${source#/}"
        done
        rewritten+=("${contexts_dir}/${name}/${source}")
    done
    if [[ "${copy_json}" == true ]]; then
        kept+=("$(jq -c -n '$ARGS.positional' --args "${rewritten[@]}" "${copy_destination}")")
    else
        kept+=("${rewritten[@]}" "${copy_destination}")
    fi
    printf '%s\n' "${kept[*]}"
}

# The extra contexts sit inside the main context, and one ignore file applies
# to every COPY alike. A COPY of the whole main context takes them along.
warn_about_whole_context_copy() {
    local source
    [[ ${#context_dirs[@]} -gt 0 ]] || return 0
    for source in "${copy_sources[@]}"; do
        while [[ "${source}" == /* || "${source}" == ./* ]]; do
            source="${source#/}"
            source="${source#./}"
        done
        case "${source%/}" in
            '' | . | '*' | '.*')
                log "mstudio-build: ${dockerfile}:${pending_line}: this ${copy_keyword} also copies ${contexts_dir}/ with the extra build contexts into the image, see docs/image-builds.md"
                return 0
                ;;
        esac
    done
}

# Prints one instruction from pending, the physical lines that
# write_context_dockerfile collected for it, and queues its here-documents.
emit_pending_instruction() {
    local keyword="" joined="" rest part from index
    local copy_keyword copy_destination copy_json
    local -a copy_flags=() copy_sources=()
    [[ "${pending[0]}" =~ ^[[:space:]]*([A-Za-z]+) ]] && keyword="${BASH_REMATCH[1],,}"
    if [[ "${keyword}" == from && "${inserted}" == false ]]; then
        print_context_stages
        inserted=true
    fi
    for part in "${pending[@]}"; do
        [[ "${part}" =~ ^[[:space:]]*(#.*)?$ ]] && continue
        part="${part%"${part##*[![:space:]]}"}"
        joined+=" ${part%"${escape}"}"
    done
    rest="${joined}"
    while [[ "${rest}" =~ ${heredoc_start} ]]; do
        heredocs+=("${BASH_REMATCH[1]}${BASH_REMATCH[2]}")
        rest="${rest#*"${BASH_REMATCH[0]}"}"
    done
    if [[ "${keyword}" == from && "${joined}" =~ [[:space:]][Aa][Ss][[:space:]]+([^[:space:]]+) ]]; then
        stages["${BASH_REMATCH[1],,}"]=1
    fi
    if [[ "${keyword}" == copy && "${joined}" =~ [[:space:]]--from=([^[:space:]]+) ]]; then
        from="${BASH_REMATCH[1],,}"
        if [[ -v context_dirs["${from}"] ]] && split_copy "${joined}"; then
            copy_from_context "${from}"
            return 0
        fi
        if [[ "${from}" =~ ^[0-9]+$ ]]; then
            for index in "${!pending[@]}"; do
                if [[ "${pending[index]}" =~ ^(.*[[:space:]])?--from=([0-9]+)([[:space:]].*)?$ ]]; then
                    pending[index]="${BASH_REMATCH[1]}--from=$((10#${BASH_REMATCH[2]} + ${#context_names[@]}))${BASH_REMATCH[3]}"
                fi
            done
        fi
    elif [[ "${keyword}" == copy || "${keyword}" == add ]] && split_copy "${joined}"; then
        warn_about_whole_context_copy
    fi
    printf '%s\n' "${pending[@]}"
}

# The stages of the extra contexts go directly in front of the first FROM, so
# FROM NAME and COPY --from=NAME resolve to them. Parser directives and global
# ARGs stay above them, otherwise they lose their effect. A numbered COPY
# --from moves by the number of inserted stages. Here-document bodies stay as
# they are.
write_context_dockerfile() {
    local source="$1" escape="\\" directives=true inserted=false line trimmed name
    local line_number=0 pending_line=0 delimiter body
    local -a pending=() heredocs=()
    local -A stages=()
    while IFS= read -r line || [[ -n "${line}" ]]; do
        line_number=$((line_number + 1))
        if [[ ${#heredocs[@]} -gt 0 ]]; then
            printf '%s\n' "${line}"
            delimiter="${heredocs[0]}"
            body="${line}"
            if [[ "${delimiter}" == -* ]]; then
                delimiter="${delimiter#-}"
                body="${line#"${line%%[!$'\t']*}"}"
            fi
            if [[ "${body}" == "${delimiter}" ]]; then
                heredocs=("${heredocs[@]:1}")
            fi
            continue
        fi
        if [[ "${directives}" == true && "${line}" =~ ^#[[:space:]]*([A-Za-z]+)[[:space:]]*=[[:space:]]*([^[:space:]]+) ]]; then
            [[ "${BASH_REMATCH[1],,}" == escape ]] && escape="${BASH_REMATCH[2]:0:1}"
            printf '%s\n' "${line}"
            continue
        fi
        directives=false
        if [[ ${#pending[@]} -eq 0 && "${line}" =~ ^[[:space:]]*(#.*)?$ ]]; then
            printf '%s\n' "${line}"
            continue
        fi
        [[ ${#pending[@]} -eq 0 ]] && pending_line="${line_number}"
        pending+=("${line}")
        trimmed="${line%"${line##*[![:space:]]}"}"
        if [[ "${trimmed}" == *"${escape}" || "${line}" =~ ^[[:space:]]*(#.*)?$ ]]; then
            continue
        fi
        emit_pending_instruction
        pending=()
    done <"${source}"
    if [[ ${#pending[@]} -gt 0 ]]; then
        emit_pending_instruction
    fi

    for name in "${context_names[@]}"; do
        if [[ -v stages["${name}"] ]]; then
            fail "--build-context ${name} has the name of a stage in ${dockerfile}, rename one of them"
        fi
    done
}

# kaniko reads one ignore file for the whole context: the one next to the
# Dockerfile, or else the one at the root. Docker looks for the first one next
# to the Dockerfile the job names, which may lie outside the context. The
# patterns of an extra context are anchored at its root, so under its prefix
# they keep their meaning. They come after the patterns of the main context,
# which an allowlist like "*" would otherwise apply to the extra contexts as
# well.
write_context_dockerignore() {
    local main_ignore="${dockerfile_source}.dockerignore" name pattern negation
    [[ -f "${main_ignore}" ]] || main_ignore="${context}/.dockerignore"
    if [[ -f "${main_ignore}" ]]; then
        cat "${main_ignore}"
        echo
    fi
    if [[ ${#context_names[@]} -eq 0 ]]; then
        echo "${contexts_dir}"
        return 0
    fi
    printf '!%s\n!%s/**\n' "${contexts_dir}" "${contexts_dir}"
    for name in "${context_names[@]}"; do
        [[ -v context_dirs["${name}"] && -f "${context_dirs[${name}]}/.dockerignore" ]] || continue
        while IFS= read -r pattern || [[ -n "${pattern}" ]]; do
            pattern="${pattern#"${pattern%%[![:space:]]*}"}"
            pattern="${pattern%"${pattern##*[![:space:]]}"}"
            [[ -z "${pattern}" || "${pattern}" == '#'* ]] && continue
            negation=""
            if [[ "${pattern}" == '!'* ]]; then
                negation='!'
                pattern="${pattern#!}"
            fi
            while [[ "${pattern}" == /* ]]; do
                pattern="${pattern#/}"
            done
            [[ -n "${pattern}" ]] || continue
            printf '%s%s/%s/%s\n' "${negation}" "${contexts_dir}" "${name}" "${pattern}"
        done <"${context_dirs[${name}]}/.dockerignore"
    done
    printf '%s/Dockerfile\n%s/Dockerfile.dockerignore\n' "${contexts_dir}" "${contexts_dir}"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -t | --tag) tags+=("$2"); shift 2 ;;
        -f | --dockerfile) dockerfile="$2"; shift 2 ;;
        --build-arg) build_args+=("$2"); shift 2 ;;
        --build-context) parse_build_context "$2"; shift 2 ;;
        --label) labels+=("$2"); shift 2 ;;
        --target) target="$2"; shift 2 ;;
        --push) push=true; shift ;;
        --iidfile) iidfile="$2"; shift 2 ;;
        --metadata-file) metadata_file="$2"; shift 2 ;;
        --platform)
            checked="$(mstudio-platform-check "$2")"
            mapfile -t platforms <<<"${checked}"
            shift 2
            ;;
        --timeout) timeout_seconds="$2"; shift 2 ;;
        --quiet) quiet=true; shift ;;
        -h | --help) usage; exit 0 ;;
        --) shift; break ;;
        -*) fail "unknown option $1 (see mstudio-build --help)" ;;
        *) context="$1"; shift ;;
    esac
done

if [[ "${push}" == true && ${#tags[@]} -eq 0 ]]; then
    fail "--push needs at least one --tag"
fi
# One tag cannot hold several images in the image store of this runner, only a
# registry can take the index that ties them together.
if [[ ${#platforms[@]} -gt 1 && "${push}" == false ]]; then
    fail "a build for $(IFS=,; echo "${platforms[*]}") needs --push, the images of several platforms only come together as one index in a registry"
fi

if [[ ! -d "${queue_dir}/queue" ]]; then
    fail "image builds are turned off for this stack. Turn them on in the mStudio extension, then the builder creates ${queue_dir}/queue."
fi
if [[ ! -w "${queue_dir}/queue" ]]; then
    fail "${queue_dir}/queue is not writable by $(id -un), check whether the builder service of this stack is running."
fi
[[ -d "${context}" ]] || fail "build context ${context} does not exist"
if [[ -z "${dockerfile}" ]]; then
    dockerfile="${context%/}/Dockerfile"
    [[ -f "${dockerfile}" ]] || fail "${dockerfile} does not exist"
elif [[ "${dockerfile}" == /* && ! -f "${dockerfile}" ]]; then
    fail "${dockerfile} does not exist"
elif [[ "${dockerfile}" != - && ! -f "${dockerfile}" ]]; then
    fail "${dockerfile} does not exist in ${PWD}. Like docker build, -f takes a path relative to the working directory, not to the context."
fi

# The builder claims a job by renaming its request, so the same rename takes
# back a job that no builder claimed yet. A claimed job is only removed once
# its result is in, because the builder reads the directory while it works. A
# job left behind by a killed runner is collected by the builder, see
# docs/image-builds.md.
withdraw() {
    local job="$1"
    [[ -f "${job}/request" ]] && mv "${job}/request" "${job}/request.withdrawn" 2>/dev/null
}

cleanup() {
    local job
    for job in "${jobs[@]}"; do
        if withdraw "${job}" || [[ -f "${job}/result" || ! -f "${job}/request.claimed" ]]; then
            rm -rf "${job}" 2>/dev/null || true
        fi
    done
    if [[ -n "${staging}" ]]; then
        rm -rf "${staging}"
    fi
}
trap cleanup EXIT

# Docker reads -f relative to the working directory, kaniko reads the
# Dockerfile from inside the context. One from elsewhere or from stdin travels
# as .mstudio-contexts/Dockerfile, like the rewritten one for extra contexts.
dockerfile_source="${dockerfile}"
dockerfile_in_context=""
if [[ "${dockerfile}" == - ]]; then
    staging="$(mktemp -d -t mstudio-build-XXXXXX)"
    dockerfile=stdin
    dockerfile_source="${staging}/stdin"
    dockerfile_from_stdin=true
    cat >"${dockerfile_source}"
    [[ -s "${dockerfile_source}" ]] || fail "-f - found no Dockerfile on stdin"
else
    dockerfile_in_context="$(path_in_context "${dockerfile}")" || true
fi

# The builder takes one context and one Dockerfile per job. Extra contexts
# travel inside the main context, next to a rewritten Dockerfile that turns
# each of them into a stage.
if [[ ${#context_names[@]} -gt 0 || -z "${dockerfile_in_context}" ]]; then
    [[ ! -e "${context}/${contexts_dir}" ]] || fail "${context}/${contexts_dir} already exists, but mstudio-build needs that path for --build-context and for a Dockerfile outside the context. Rename it."
    staging="${staging:-$(mktemp -d -t mstudio-build-XXXXXX)}"
    mkdir "${staging}/${contexts_dir}"
    if [[ ${#context_names[@]} -gt 0 ]]; then
        write_context_dockerfile "${dockerfile_source}" >"${staging}/${contexts_dir}/Dockerfile"
    else
        cp "${dockerfile_source}" "${staging}/${contexts_dir}/Dockerfile"
    fi
    write_context_dockerignore >"${staging}/${contexts_dir}/Dockerfile.dockerignore"
    request_dockerfile="${contexts_dir}/Dockerfile"
else
    request_dockerfile="${dockerfile_in_context}"
fi
if [[ ${#context_names[@]} -gt 0 ]]; then
    (cd "${staging}" && mstudio-dockerfile-check "${contexts_dir}/Dockerfile")
elif [[ "${dockerfile_from_stdin}" == true ]]; then
    (cd "${staging}" && mstudio-dockerfile-check stdin)
else
    mstudio-dockerfile-check "${dockerfile}"
fi
if [[ ${#platforms[@]} -eq 0 ]]; then
    platforms=("")
fi

builder_platforms() {
    local line
    if [[ -f "${queue_dir}/builder.env" ]]; then
        while IFS= read -r line; do
            [[ "${line}" == PLATFORMS=* ]] && echo "${line#PLATFORMS=}"
        done <"${queue_dir}/builder.env"
    fi
}

# The builder lists its native platform first. Before a builder ever started,
# the runner shares the host with it and has the same architecture.
native_platform() {
    local platforms
    platforms="$(builder_platforms)"
    if [[ -n "${platforms}" ]]; then
        echo "${platforms%%,*}"
        return 0
    fi
    case "$(uname -m)" in
        x86_64) echo linux/amd64 ;;
        aarch64) echo linux/arm64 ;;
        *) echo "linux/$(uname -m)" ;;
    esac
}

# kaniko reports a RUN step that executes a binary of the other architecture as
# "exec format error". Whether that is expected depends on the probe of the
# builder, so the message tells which of the two cases this is. A build without
# --platform is a build for the native platform, which always runs RUN steps.
explain_failure() {
    local platform="${1:-$(native_platform)}" log_file="$2"
    grep -q 'exec format error' "${log_file}" 2>/dev/null || return 0
    if [[ "${platform}" == "$(native_platform)" || ",$(builder_platforms)," == *",${platform},"* ]]; then
        echo "mstudio-build: a RUN step started a binary that does not match ${platform}. Check the architecture of the files the Dockerfile downloads or copies." >&2
    else
        echo "mstudio-build: the builder cannot run RUN steps for ${platform}, it found no emulation on startup (see the log of the builder service). Build in a stage with FROM --platform=\$BUILDPLATFORM and cross-compile for \$TARGETARCH, or use only COPY in ${platform} stages." >&2
    fi
}

# Sends the context to the builder for one platform, streams the log and sets
# job to the job directory once the build succeeded.
build_for() {
    local platform="$1" destination="$2"
    job="$(mktemp -d "${queue_dir}/queue/build-$(date +%s)-XXXXXX")"
    jobs+=("${job}")
    local job_id="${job##*/}" result="${job}/result"
    mkdir -p "${job}/context"

    log "mstudio-build: sending ${context}${context_names[*]:+ with the build contexts ${context_names[*]}} to the builder (job ${job_id}${platform:+, ${platform}})"
    tar -c -C "${context}" . | tar -x -C "${job}/context"
    if [[ -n "${staging}" ]]; then
        cp -R "${staging}/${contexts_dir}" "${job}/context/"
        local name
        for name in "${!context_dirs[@]}"; do
            mkdir "${job}/context/${contexts_dir}/${name}"
            tar -c -C "${context_dirs[${name}]}" . | tar -x -C "${job}/context/${contexts_dir}/${name}"
        done
    fi

    if [[ ${#build_args[@]} -gt 0 ]]; then
        printf '%s\n' "${build_args[@]}" >"${job}/build-args"
    fi
    if [[ ${#labels[@]} -gt 0 ]]; then
        printf '%s\n' "${labels[@]}" >"${job}/labels"
    fi

    {
        echo "DOCKERFILE=${request_dockerfile}"
        [[ -n "${destination}" ]] && echo "DESTINATION=${destination}"
        [[ -n "${target}" ]] && echo "TARGET=${target}"
        [[ -n "${platform}" ]] && echo "PLATFORM=${platform}"
    } >"${job}/request.tmp"
    mv "${job}/request.tmp" "${job}/request"

    local deadline=$((SECONDS + timeout_seconds)) tail_pid=""
    while [[ ! -f "${result}" ]]; do
        if [[ -z "${tail_pid}" && -f "${job}/log" ]]; then
            tail -n +1 -f "${job}/log" >&2 &
            tail_pid=$!
        fi
        if ((SECONDS > deadline)); then
            [[ -n "${tail_pid}" ]] && kill "${tail_pid}" 2>/dev/null
            if withdraw "${job}"; then
                fail "no builder took the job within ${timeout_seconds}s, so it was taken back. Check that the builder service of this stack is running in mStudio."
            fi
            fail "no result after ${timeout_seconds}s. The job stays in ${job} for the builder, check the log of the builder service in mStudio."
        fi
        sleep 1
    done
    sleep 1
    [[ -n "${tail_pid}" ]] && kill "${tail_pid}" 2>/dev/null || true

    local exit_code="" line
    for _ in 1 2 3 4 5; do
        line="$(cat "${result}" 2>/dev/null || true)"
        if [[ "${line}" =~ ^exit=([0-9]+)$ ]]; then
            exit_code="${BASH_REMATCH[1]}"
            break
        fi
        sleep 1
    done
    [[ -n "${exit_code}" ]] || fail "the builder wrote an unreadable result: $(cat "${result}" 2>/dev/null)"

    if [[ "${exit_code}" != "0" ]]; then
        [[ -f "${job}/log" ]] && tail -n 40 "${job}/log" >&2
        explain_failure "${platform}" "${job}/log"
        local pushed_nothing=""
        [[ "${push}" == true ]] && pushed_nothing=", nothing was pushed"
        echo "mstudio-build: the build${platform:+ for ${platform}} failed with exit code ${exit_code}${pushed_nothing}" >&2
        exit "${exit_code}"
    fi
}

# registry/name:tag and registry:port/name@sha256:... both lose everything
# after the name.
repository_of() {
    local reference="${1%%@*}" last
    last="${reference##*/}"
    if [[ "${last}" == *:* ]]; then
        reference="${reference%:*}"
    fi
    echo "${reference}"
}

tag_of() {
    local reference="${1%%@*}" last
    last="${reference##*/}"
    if [[ "${last}" == *:* ]]; then
        echo "${last##*:}"
    else
        echo latest
    fi
}

repositories() {
    local tag repository
    local -A seen=()
    for tag in "${tags[@]}"; do
        repository="$(repository_of "${tag}")"
        if [[ ! -v seen["${repository}"] ]]; then
            seen["${repository}"]=1
            echo "${repository}"
        fi
    done
}

# The upload is what fails in practice: large layers, credentials that only
# cover some repositories, quotas. It goes to every repository by digest first,
# so a failure there leaves every tag where it was.
upload() {
    local tarball="$1" digest="$2" repository
    for repository in "${@:3}"; do
        log "mstudio-build: pushing ${repository}@${digest}"
        if ! mstudio-crane "${repository}" push "${tarball}" "${repository}@${digest}" >/dev/null; then
            fail "uploading ${digest} to ${repository} failed, no tag was changed"
        fi
    done
}

# crane index append only writes to a tag. The index is built here instead and
# goes to every repository by digest with crane edit manifest, so it exists
# everywhere before a tag moves. The children are the same in every repository,
# and so are the index and its digest.
build_index() {
    local repository="$1" digest size platform
    : >"${job}/children.jsonl"
    for digest in "${@:2}"; do
        mstudio-crane "${repository}" manifest "${repository}@${digest}" >"${job}/child.json"
        size="$(wc -c <"${job}/child.json")"
        platform="$(mstudio-crane "${repository}" config "${repository}@${digest}" | jq -c '{architecture, os, variant} | with_entries(select(.value != null and .value != ""))')"
        jq -c --arg digest "${digest}" --argjson size "${size}" --argjson platform "${platform}" \
            '{mediaType, size: $size, digest: $digest} + (if $platform == {} then {} else {platform: $platform} end)' \
            "${job}/child.json" >>"${job}/children.jsonl"
    done
    jq -j -c -s '{schemaVersion: 2, mediaType: "application/vnd.oci.image.index.v1+json", manifests: .}' \
        "${job}/children.jsonl" >"${job}/index.json"
    index_digest="sha256:$(sha256sum "${job}/index.json" | cut -d ' ' -f 1)"
}

# Registries have no transaction across tags. Every manifest is already in every
# repository, so each tag is one small manifest PUT. When one fails, the tags
# that moved before it go back to the digest they had.
declare -A previous=()
ordered=()
moved=()

record_previous() {
    local tag digest
    for tag in "${tags[@]}"; do
        [[ -v previous["${tag}"] ]] && continue
        if digest="$(mstudio-crane "${tag}" digest "${tag}" 2>"${job}/crane.err")"; then
            previous["${tag}"]="${digest}"
        elif grep -q -E '^Error: .*(MANIFEST_UNKNOWN|NAME_UNKNOWN|NOT_FOUND|status code 404)' "${job}/crane.err"; then
            previous["${tag}"]=""
        else
            cat "${job}/crane.err" >&2
            fail "reading the current digest of ${tag} failed, no tag was changed"
        fi
        ordered+=("${tag}")
    done
}

roll_back() {
    local failed="$1" digest="$2" tag unrestored=() untouched=false
    if [[ ${#moved[@]} -eq 0 ]]; then
        fail "tagging ${failed} failed, no tag was changed"
    fi
    echo "mstudio-build: tagging ${failed} failed, moving the tags that already moved back" >&2
    for tag in "${moved[@]}"; do
        if [[ -z "${previous[${tag}]}" ]]; then
            echo "mstudio-build: ${tag} did not exist before and stays at ${digest}" >&2
        elif mstudio-crane "${tag}" tag "$(repository_of "${tag}")@${previous[${tag}]}" "$(tag_of "${tag}")" >/dev/null 2>"${job}/crane.err"; then
            echo "mstudio-build: ${tag} points at ${previous[${tag}]} again" >&2
        else
            cat "${job}/crane.err" >&2
            echo "mstudio-build: ${tag} still points at ${digest}, moving it back to ${previous[${tag}]} failed" >&2
            unrestored+=("${tag}")
        fi
    done
    for tag in "${ordered[@]}"; do
        [[ "${tag}" == "${failed}" ]] && untouched=true
        if [[ "${untouched}" == true ]]; then
            echo "mstudio-build: ${tag} was not changed" >&2
        fi
    done
    if [[ ${#unrestored[@]} -gt 0 ]]; then
        fail "tagging ${failed} failed and $(IFS=,; echo "${unrestored[*]}") could not be moved back. Set them with crane tag <repository>@<previous digest> <tag>."
    fi
    fail "tagging ${failed} failed, every tag that existed before points at its previous image again"
}

tag_everywhere() {
    local digest="$1" tag
    record_previous
    for tag in "${ordered[@]}"; do
        log "mstudio-build: tagging ${tag}"
        if ! mstudio-crane "${tag}" tag "$(repository_of "${tag}")@${digest}" "$(tag_of "${tag}")" >/dev/null 2>"${job}/crane.err"; then
            cat "${job}/crane.err" >&2
            roll_back "${tag}" "${digest}"
        fi
        moved+=("${tag}")
    done
}

write_outputs() {
    local image_id="$1" manifest_digest="$2"
    if [[ -n "${iidfile}" ]]; then
        if [[ -n "${manifest_digest}" ]]; then
            printf '%s' "${manifest_digest}" >"${iidfile}"
        else
            printf '%s' "${image_id}" >"${iidfile}"
        fi
    fi

    # The fields `docker/build-push-action` exposes as its imageid, digest and
    # metadata outputs. Workflows read them to tag deployments, so an empty file
    # would break steps that do.
    if [[ -n "${metadata_file}" ]]; then
        jq -n \
            --arg config "${image_id}" \
            --arg digest "${manifest_digest}" \
            --arg names "$(
                IFS=,
                echo "${tags[*]:-}"
            )" \
            '(if $config == "" then {} else {"containerimage.config.digest": $config} end)
                + (if $digest == "" then {} else {"containerimage.digest": $digest} end)
                + (if $names == "" then {} else {"image.name": $names} end)' \
            >"${metadata_file}"
    fi
}

if [[ ${#platforms[@]} -eq 1 ]]; then
    build_for "${platforms[0]}" "${tags[0]:-}"
    image_id="$(mstudio-image-store put "${job}/image.tar" "${tags[@]}")"

    # crane builds the manifest from the tarball, so its digest differs from what
    # kaniko would have pushed itself. Without a push there is no digest to report.
    manifest_digest=""
    if [[ "${push}" == true ]]; then
        manifest_digest="$(crane digest --tarball "${job}/image.tar")"
        mapfile -t targets < <(repositories)
        upload "${job}/image.tar" "${manifest_digest}" "${targets[@]}"
        tag_everywhere "${manifest_digest}"
    fi
    write_outputs "${image_id}" "${manifest_digest}"

    if [[ ${#tags[@]} -gt 0 ]]; then
        printf '%s\n' "${tags[0]}"
    else
        printf '%s\n' "${image_id}"
    fi
    exit 0
fi

tarballs=()
for platform in "${platforms[@]}"; do
    build_for "${platform}" "${tags[0]}"
    tarballs+=("${job}/image.tar")
done

# No tag ever points at a single platform image, the index is the only thing
# that gets tagged.
mapfile -t targets < <(repositories)
children=()
for tarball in "${tarballs[@]}"; do
    digest="$(crane digest --tarball "${tarball}")"
    upload "${tarball}" "${digest}" "${targets[@]}"
    children+=("${digest}")
done
build_index "${targets[0]}" "${children[@]}"
for repository in "${targets[@]}"; do
    log "mstudio-build: pushing ${repository}@${index_digest} as an index of $(IFS=,; echo "${platforms[*]}")"
    if ! pushed="$(mstudio-crane "${repository}" edit manifest -m application/vnd.oci.image.index.v1+json "${repository}@${children[0]}" <"${job}/index.json")"; then
        fail "pushing the index to ${repository} failed, no tag was changed"
    fi
    [[ "${pushed}" == *"@${index_digest}" ]] || fail "${repository} stored the index as ${pushed#*@} instead of ${index_digest}, no tag was changed"
done
tag_everywhere "${index_digest}"
write_outputs "" "${index_digest}"

printf '%s\n' "${tags[0]}"
