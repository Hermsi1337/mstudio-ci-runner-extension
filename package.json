{
  "name": "mstudio-ci-runner-extension",
  "type": "module",
  "version": "0.6.1",
  "packageManager": "pnpm@9.14.4",
  "scripts": {
    "init:encryption": "node scripts/generate-encryption-secrets.js",
    "dev": "dotenv -- vite dev --host --config config/vite.config.ts",
    "dev:all": "scripts/dev.sh",
    "dev:expose": "dotenv -- bash -c 'zrok share public -n $ZROK_SHARE_NAME ${PORT:-3000}'",
    "build": "vite build --config config/vite.config.ts",
    "serve": "vite preview --config config/vite.config.ts",
    "codegen": "openapi-ts -f config/openapi-ts.config.ts",
    "spec:update": "node scripts/slim-openapi.ts",
    "extension:sync": "node scripts/sync-extension.ts",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config config/vitest.config.ts --project unit",
    "test:integration": "vitest run --config config/vitest.config.ts --project integration",
    "test:all": "vitest run --config config/vitest.config.ts",
    "db:start": "scripts/dev-db.sh up",
    "db:stop": "scripts/dev-db.sh down",
    "db:push": "drizzle-kit push --config config/drizzle.config.ts",
    "db:generate-migrations": "drizzle-kit generate --config config/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config config/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --port 8081 --config config/drizzle.config.ts",
    "runner:build": "bash scripts/build-runner-images.sh",
    "image:build": "docker build -f docker/extension/Dockerfile -t mstudio-ci-runner-extension:local .",
    "check:bundle": "bash scripts/check-client-bundle.sh"
  },
  "dependencies": {
    "@mittwald/api-client": "^4.465.0",
    "@mittwald/ext-bridge": "1.1.48",
    "@mittwald/flow-react-components": "1.1.48",
    "@mittwald/flow-remote-react-components": "1.1.48",
    "@mittwald/mstudio-ext-react-components": "1.1.48",
    "@mittwald/react-ghostmaker": "^1.5.4",
    "@mittwald/react-use-promise": "^4.2.3",
    "@octokit/request-error": "^7.1.2",
    "@octokit/rest": "^22.0.1",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.56",
    "@weissaufschwarz/mitthooks": "^0.3.0",
    "@weissaufschwarz/mitthooks-drizzle": "^0.1.0",
    "drizzle-orm": "^0.44.7",
    "envalid": "^8.2.0",
    "nitro": "3.0.1-alpha.2",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.5",
    "react-hook-form": "^7.88.0",
    "simple-icons": "^16.31.0",
    "uuid": "^14.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@hey-api/openapi-ts": "^0.99.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "testcontainers": "^12.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "private": true,
  "description": "mittwald mStudio extension that provisions CI runners (GitHub Actions, GitLab CI, Forgejo Actions) on container hosting",
  "author": "codeBoarder - Inh. Dennis Hermsmeier <hello@codeboarder.de>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hermsi1337/mstudio-ci-runner-extension.git"
  },
  "bugs": {
    "url": "https://github.com/Hermsi1337/mstudio-ci-runner-extension/issues"
  },
  "homepage": "https://github.com/Hermsi1337/mstudio-ci-runner-extension#readme"
}
