# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=extension
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USE_SSL=false

PORT=3000

# Logging: LOG_LEVEL debug|info|warn|error, LOG_FORMAT text|json (json when NODE_ENV=production)
LOG_LEVEL=debug
LOG_FORMAT=text

# Extension
EXTENSION_ID=your_extension_id_here
EXTENSION_SECRET=your_extension_secret_here
# ENCRYPTION_MASTER_PASSWORD and ENCRYPTION_SALT can be filled by executing `pnpm run init:encryption`
ENCRYPTION_MASTER_PASSWORD=changeme
ENCRYPTION_SALT=changeme
# zrok share name for `pnpm run dev:expose`, e.g. public:ci-runner-local
ZROK_SHARE_NAME=

# Runner images used for new runner containers, one per provider
RUNNER_IMAGE_GITHUB=ghcr.io/hermsi1337/mstudio-ci-runner-github:latest
RUNNER_IMAGE_GITLAB=ghcr.io/hermsi1337/mstudio-ci-runner-gitlab:latest

# Local mode: UI on http://localhost:3000/local without mStudio, see docs/development.md
# LOCAL_API_TOKEN=
# LOCAL_PROJECT_ID=
