# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=extension
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USE_SSL=false

PORT=3000

# Logging: LOG_LEVEL debug|info|warn|error, LOG_FORMAT text|json (json when NODE_ENV=production)
LOG_LEVEL=debug
LOG_FORMAT=text

# Extension
EXTENSION_ID=your_extension_id_here
EXTENSION_SECRET=your_extension_secret_here
# ENCRYPTION_MASTER_PASSWORD and ENCRYPTION_SALT can be filled by executing `pnpm run init:encryption`
ENCRYPTION_MASTER_PASSWORD=changeme
ENCRYPTION_SALT=changeme
# zrok share name for `pnpm run dev:expose`, e.g. public:ci-runner-local
ZROK_SHARE_NAME=

# Runner images default to ghcr.io/hermsi1337/mstudio-ci-runner-<provider>:<EXTENSION_VERSION>,
# EXTENSION_VERSION defaults to the version in package.json. Override only to test other images.
# EXTENSION_VERSION=
# RUNNER_IMAGE_GITHUB=
# RUNNER_IMAGE_GITLAB=
